{
  "name": "qti3",
  "version": "0.13.4",
  "private": true,
  "description": "Framework-neutral TypeScript packages for QTI 3 assessment items.",
  "keywords": [
    "1edtech",
    "assessment",
    "assessment-items",
    "qti",
    "qti3",
    "typescript"
  ],
  "homepage": "https://github.com/LongsightGroup/qti3#readme",
  "bugs": {
    "url": "https://github.com/LongsightGroup/qti3/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Sam Ottenhoff",
    "url": "https://github.com/ottenhoff"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LongsightGroup/qti3.git"
  },
  "type": "module",
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "node scripts/install-git-hooks.mjs",
    "lint": "pnpm build && pnpm lint:raw",
    "lint:raw": "oxlint --deny-warnings packages examples tests scripts playwright.config.ts vitest.config.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:conformance": "vitest run packages/conformance",
    "test:external": "vitest run packages/conformance/src/external-qti.test.ts",
    "test:external:required": "QTI3_REQUIRE_EXTERNAL=1 vitest run packages/conformance/src/external-qti.test.ts",
    "test:a11y": "vitest run packages/a11y",
    "test:browser": "playwright test",
    "check:deps": "node scripts/check-dependencies.mjs",
    "check:maps": "node scripts/check-package-source-maps.mjs",
    "check:exports": "node scripts/check-package-exports.mjs",
    "check:transcoder-support": "node scripts/assert-transcoder-support.mjs",
    "check:transcoder-xsd": "node scripts/prepare-qti-xsd.mjs && node scripts/check-transcoder-xsd.mjs",
    "check:test-xsd": "node scripts/check-test-xsd.mjs",
    "build": "node scripts/clean-package-dist.mjs && tsc -b",
    "pages:build": "vite build examples/manual --base /qti3/ --outDir ../../dist/pages --emptyOutDir",
    "dev": "vite --host 127.0.0.1 examples/manual",
    "dev:1edtech": "vite --host 127.0.0.1 examples/manual --open /1edtech.html",
    "dev:adapter-react": "vite --host 127.0.0.1 examples/manual --open /adapter-react.html",
    "readiness:basic:item-player": "vitest run packages/conformance/src/conformance.test.ts packages/fixtures/src/fixtures.test.ts packages/cli/src/index.test.ts && playwright test --grep \"Basic item player readiness\" && pnpm build && node packages/cli/dist/index.js basic-item-player-report packages/fixtures/packages/basic-item-player",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint:raw && pnpm test && pnpm check:deps && pnpm build && pnpm check:maps && pnpm check:exports && pnpm check:transcoder-support && pnpm check:information-model",
    "release:check": "pnpm verify && pnpm check:semantic-mutations && pnpm check:transcoder-xsd && pnpm check:test-xsd && node scripts/assert-transcoder-support.mjs --release && pnpm test:browser && node packages/cli/dist/index.js assert-support && node packages/cli/dist/index.js run-fixtures",
    "certification:check": "pnpm test:external:required && QTI3_REQUIRE_EXTERNAL=1 pnpm release:check && pnpm certification:evidence",
    "certification:evidence": "node scripts/certification-evidence.mjs",
    "check:information-model": "node scripts/check-information-model.mjs",
    "test:semantic": "vitest run packages/fixtures/src/challenges.test.ts packages/core/src/test-execution-profile.test.ts packages/core/src/session-sequences.test.ts packages/core/src/challenge-items.test.ts packages/migrator/src/choice-semantic-matrix.test.ts packages/migrator/src/scoring-fidelity.test.ts",
    "check:semantic-mutations": "node scripts/check-semantic-mutations.mjs"
  },
  "devDependencies": {
    "@interfere/landmines": "0.1.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "axe-core": "4.14.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "tsrs": "7.1.0-beta.tsrs3",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.21.0"
}
